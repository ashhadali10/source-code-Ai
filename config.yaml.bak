scanner:
  target_languages:
    - java
    - javascript
    - vue
    - esql
    - docker
  exclude_dirs:
    - node_modules
    - target
    - build
    - dist
    - coverage
    - vendor
    - venv
    - .git
    - __pycache__
    - .scanner_cache

llm:
  provider: ollama
  url: http://localhost:11434/api/chat
  model: qwen2.5-coder:14b
  models:
    - qwen2.5-coder:14b
  timeout: 180
  max_workers: 1
  num_ctx: 8192
  num_predict: 1024
  keep_alive: 5m
  review_mode: never
  min_confidence: 0.6

ai_code_review:
  enabled: true
  max_file_lines: 150
  max_total_lines: 600

database:
  path: .scanner_data/scanner.db

reporting:
  output_dir: ./reports
  mask_secrets: true
  snippet_lines: 50      # NEW: bigger snippets

tools:
  semgrep: true
  gitleaks: true
  hadolint: true
  trivy: true
